# EditorConfig (https://editorconfig.org)
# Cross-editor coding-style settings; applied by editors that support EditorConfig.
root = true

# Settings for all files
[*]
# Ensure all files are saved in UTF-8 encoding
charset = utf-8
# Use LF line endings (Unix style)
end_of_line = lf
# Use spaces for indentation
indent_style = space
# Always use 2 spaces for indentation (R, C, Python, etc.)
indent_size = 2
# Max line length
max_line_length = 120
# Remove trailing whitespace
trim_trailing_whitespace = true
